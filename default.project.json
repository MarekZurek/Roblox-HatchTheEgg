{
  "name": "HatchTheEgg",
  "serveAddress": "127.0.0.1",
  "servePlaceIds": [],
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "LightingStyle": "Soft",
        "PrioritizeLightingQuality": false,
        "GlobalShadows": true
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "HatchTheEgg": { "$path": "src/server", "$ignoreUnknownInstances": true }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "HatchTheEgg": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Shared": { "$path": "src/shared", "$ignoreUnknownInstances": true }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "HatchTheEggClient": { "$path": "src/client", "$ignoreUnknownInstances": true }
      }
    }
  }
}
